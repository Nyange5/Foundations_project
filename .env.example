# Copy to .env and fill in. Never commit the real .env file.

# development locally, production on the VPS
FLASK_ENV=development

# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Database container settings
POSTGRES_USER=etike
POSTGRES_PASSWORD=change-me
POSTGRES_DB=etike

# The API reads this. Host "db" is the database container name.
DATABASE_URL=postgresql+psycopg://etike:change-me@db:5432/etike

# Optional: separate database used by tests (defaults to in-memory SQLite)
# TEST_DATABASE_URL=postgresql+psycopg://etike:change-me@localhost:5432/etike_test

# Optional: Gunicorn worker count in production
# GUNICORN_WORKERS=3
